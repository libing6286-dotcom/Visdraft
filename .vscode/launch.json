{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug Loomic Server",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}/apps/server",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "--inspect-brk=9229",
        "--watch",
        "--env-file=../../.env.local",
        "--import",
        "tsx",
        "./src/server.ts"
      ],
      "autoAttachChildProcesses": true,
      "skipFiles": ["<node_internals>/**"],
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen"
    },
    {
      "name": "Debug Loomic Worker",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}/apps/server",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "--inspect-brk=9230",
        "--env-file=../../.env.local",
        "--import",
        "tsx",
        "./src/worker.ts"
      ],
      "autoAttachChildProcesses": true,
      "skipFiles": ["<node_internals>/**"],
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen"
    },
    {
      "name": "Attach to Loomic Server",
      "type": "node",
      "request": "attach",
      "port": 9229,
      "address": "localhost",
      "restart": false,
      "skipFiles": ["<node_internals>/**"],
      "localRoot": "${workspaceFolder}/apps/server",
      "remoteRoot": "${workspaceFolder}/apps/server"
    }
  ]
}
